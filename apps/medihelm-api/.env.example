PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/medihelm?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
CORS_ORIGINS=https://medihelm.com,https://app.medihelm.com,https://grossiste.medihelm.com,https://institutionnel.medihelm.com,https://admin.medihelm.com

# RSA-256 : clés PEM DPMED; fournir les deux via un gestionnaire de secrets en environnement sécurisé.
# Sans ces clés, la publication des alertes reste bloquée en brouillon.
DPMED_PRIVATE_KEY=
DPMED_PUBLIC_KEY=
