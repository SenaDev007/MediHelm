# Copy to .env.local and set values from a secret manager. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXTAUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MediHelm
NEXT_PUBLIC_MAPBOX_TOKEN=REPLACE_ME

# Payment provider (sandbox credentials only in local development)
FEDAPAY_SECRET_KEY=REPLACE_ME
FEDAPAY_ENV=sandbox

# Notifications
AFRICAS_TALKING_API_KEY=REPLACE_ME
AFRICAS_TALKING_USERNAME=REPLACE_ME
AFRICAS_TALKING_SENDER=REPLACE_ME
AFRICAS_TALKING_ENV=sandbox
FCM_SERVER_KEY=REPLACE_ME
FIREBASE_SERVER_KEY=REPLACE_ME
RESEND_API_KEY=REPLACE_ME
EMAIL_FROM=no-reply@example.invalid

# Institutional webhook keys (required; handlers fail closed when absent)
# Configure only trusted proxy egress IPs; do not trust arbitrary client headers.
DPMED_WEBHOOK_SECRET=REPLACE_ME
UBIPHARM_WEBHOOK_SECRET=REPLACE_ME
PROMOPHARMA_WEBHOOK_SECRET=REPLACE_ME
SOBAPS_WEBHOOK_SECRET=REPLACE_ME
DPMED_IP_WHITELIST=REPLACE_WITH_TRUSTED_PROXY_IPS
UBIPHARM_IP_WHITELIST=REPLACE_WITH_TRUSTED_PROXY_IPS
PROMOPHARMA_IP_WHITELIST=REPLACE_WITH_TRUSTED_PROXY_IPS
SOBAPS_IP_WHITELIST=REPLACE_WITH_TRUSTED_PROXY_IPS
DPMED_PUBLIC_KEY=REPLACE_ME
RSA_PRIVATE_KEY=REPLACE_ME
RSA_PUBLIC_KEY=REPLACE_ME
