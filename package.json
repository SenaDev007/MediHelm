{
  "name": "medihelm",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:api": "pnpm --filter @medihelm/api dev",
    "dev:public": "pnpm --filter @medihelm/public dev",
    "dev:web": "pnpm --filter @medihelm/web dev",
    "dev:grossiste": "pnpm --filter @medihelm/grossiste dev",
    "dev:institutionnel": "pnpm --filter @medihelm/institutionnel dev",
    "db:generate": "pnpm --filter @medihelm/database db:generate",
    "db:migrate": "pnpm --filter @medihelm/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @medihelm/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @medihelm/database db:migrate:status",
    "db:institution:create-user": "pnpm --filter @medihelm/database db:institution:create-user"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
