{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@backend/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "prisma/**/*.ts",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
